# 虚拟环境
.venv/

# IDE配置
.idea/

# 本地 Claude Code 配置（个人机器设置，不入库）
.claude/settings.local.json

# Python缓存
__pycache__/
*.pyc
*.pyo

# 环境变量（可能含密钥）
.env

# SQLite临时文件
*.db-shm
*.db-wal

# LangGraph 对话记忆（运行时数据，会不断变大，不入库）
resources/checkpoints.db

# 业务数据库（含个人偏好/健身档案/饮食记录等隐私数据，首次运行自动创建，不入库）
resources/personal_chief.db

# RAG 向量缓存（由 data/recipes.json 自动重建，不入库）
resources/recipe_vectors.npz

# AI 现编回流的菜谱库（运行时自进化生成，不入库；容器重启可能重置）
resources/recipes_generated.json
resources/recipes_generated.json.tmp

# Chroma 向量库（chroma 后端的持久化目录，由 data/recipes.json 自动重建，不入库）
resources/chroma_db/

# 运营埋点数据库与导出（运行时生成，含使用数据，不入库）
resources/analytics.db
resources/analytics_export.csv

# 本地 embedding 模型缓存（约90MB 二进制，首次运行自动下载，不入库）
resources/fastembed_cache/

# 本地部署教程与生成脚本（含个人用户名/部署细节，仅本地参考，不入公开仓库）
部署教程.md
部署教程.docx
make_docx.py

# 系统文件
.DS_Store
Thumbs.db