# 后端镜像构建上下文：排除虚拟环境、前端、缓存、隐私数据与密钥
.venv/
__pycache__/
*.pyc
*.pyo
.git/
.idea/
.claude/

# 前端有自己的镜像，后端不需要
frontend/

# 运行时/隐私数据（容器用挂载卷，不进镜像）
resources/checkpoints.db
resources/personal_chief.db
resources/analytics.db
resources/analytics_export.csv
resources/recipe_vectors.npz
resources/fastembed_cache/
*.db-shm
*.db-wal

# 密钥绝不进镜像（通过 docker compose 的 env_file 注入）
.env

# 桌面文档/其它
*.md
!README.md
